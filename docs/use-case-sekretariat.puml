@startuml Use Case - Sekretariat (Admin Panel)

skinparam backgroundColor #FEFEFE
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
  FontSize 11
}
skinparam actor {
  BackgroundColor #FEE2E2
  BorderColor #DC2626
}
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #1E293B
}
skinparam ArrowColor #64748B
skinparam note {
  BackgroundColor #FEF9C3
  BorderColor #CA8A04
}

title **Use Case Diagram — Sekretariat (Admin Panel)**\nLaravel Blade · Port 8001\nAktor: Admin / Sekretaris Gereja

actor "Admin /\nSekretaris" as Admin #LightCoral

rectangle "Sistem Sekretariat — Admin Panel (Port 8001)" {

  ' ---------- AUTENTIKASI ----------
  package "Autentikasi" {
    usecase "Login\n(ID Jemaat + Password)" as UC_Login
    usecase "Logout" as UC_Logout
  }

  ' ---------- MANAJEMEN JEMAAT ----------
  package "Manajemen Data Jemaat" {
    usecase "Lihat Daftar\nJemaat" as UC_ListMember
    usecase "Cari & Filter\nJemaat" as UC_SearchMember
    usecase "Tambah Data\nJemaat Baru" as UC_CreateMember
    usecase "Lihat Detail\nJemaat" as UC_ShowMember
    usecase "Edit Data\nJemaat" as UC_EditMember
    usecase "Hapus Data\nJemaat" as UC_DeleteMember

    note right of UC_CreateMember
      ID Jemaat di-generate otomatis
      dari tanggal lahir (DDMMYYYY)
      Password default: 12345
    end note
  }

  ' ---------- MANAJEMEN SURAT ----------
  package "Manajemen Surat Gereja" {
    usecase "Lihat Daftar\nSemua Surat" as UC_ListLetter
    usecase "Cari & Filter\nSurat" as UC_SearchLetter
    usecase "Buat Surat\nBaru" as UC_CreateLetter
    usecase "Lihat Detail\nSurat" as UC_ShowLetter
    usecase "Edit Data\nSurat" as UC_EditLetter
    usecase "Hapus Surat" as UC_DeleteLetter
    usecase "Download / Generate\nPDF Surat" as UC_PdfLetter

    note right of UC_CreateLetter
      7 Tipe Surat:
      · Surat Tugas Pelayanan
      · Surat Pengantar
      · Surat Ket. Jemaat Aktif
      · Surat Nilai Sekolah
      · Surat Pengajuan Baptisan
      · Surat Penyerahan Anak
      · Surat Pengajuan Pernikahan
    end note

    note bottom of UC_PdfLetter
      Nomor surat: NNN/GPdI/SA/ABBREV/YEAR
      Generate on-the-fly via DomPDF
      jika file belum tersimpan
    end note
  }

  ' ---------- KELOLA PENGAJUAN ----------
  package "Kelola Pengajuan Surat Jemaat" {
    usecase "Lihat Daftar\nPengajuan" as UC_ListPengajuan
    usecase "Filter Pengajuan\nper Status" as UC_FilterPengajuan
    usecase "Lihat Detail\nPengajuan" as UC_ShowPengajuan
    usecase "Setujui Pengajuan\n(Generate Surat Otomatis)" as UC_Approve
    usecase "Tolak Pengajuan\n(+ Catatan Alasan)" as UC_Reject
    usecase "Hapus Data\nPengajuan" as UC_DeletePengajuan

    note right of UC_Approve
      Otomatis membuat record Letter
      dan nomor surat baru
    end note
  }

  ' ---------- KONTEN WEBSITE ----------
  package "Kelola Konten Website Publik" {
    usecase "Lihat Jadwal\nPelayanan" as UC_ListJadwal
    usecase "Tambah Jadwal\nPelayanan" as UC_AddJadwal
    usecase "Edit Jadwal\nPelayanan" as UC_EditJadwal
    usecase "Hapus Jadwal\nPelayanan" as UC_DelJadwal

    usecase "Lihat Galeri\nFoto" as UC_ListGaleri
    usecase "Upload Foto\nGaleri" as UC_UploadGaleri
    usecase "Hapus Foto\nGaleri" as UC_DelGaleri

    usecase "Lihat\nPengumuman" as UC_ListPengumuman
    usecase "Tambah\nPengumuman" as UC_AddPengumuman
    usecase "Edit\nPengumuman" as UC_EditPengumuman
    usecase "Hapus\nPengumuman" as UC_DelPengumuman
  }

}

' ============================================================
' ASSOCIATIONS
' ============================================================

' Autentikasi
Admin --> UC_Login
Admin --> UC_Logout

' Manajemen Jemaat
Admin --> UC_ListMember
Admin --> UC_CreateMember
Admin --> UC_ShowMember
Admin --> UC_EditMember
Admin --> UC_DeleteMember
UC_ListMember .> UC_SearchMember : <<include>>

' Manajemen Surat
Admin --> UC_ListLetter
Admin --> UC_CreateLetter
Admin --> UC_ShowLetter
Admin --> UC_EditLetter
Admin --> UC_DeleteLetter
Admin --> UC_PdfLetter
UC_ListLetter .> UC_SearchLetter : <<include>>

' Pengajuan
Admin --> UC_ListPengajuan
Admin --> UC_ShowPengajuan
Admin --> UC_Approve
Admin --> UC_Reject
Admin --> UC_DeletePengajuan
UC_ListPengajuan .> UC_FilterPengajuan : <<include>>
UC_ShowPengajuan .> UC_Approve : <<extend>>
UC_ShowPengajuan .> UC_Reject  : <<extend>>

' Konten
Admin --> UC_ListJadwal
Admin --> UC_AddJadwal
Admin --> UC_EditJadwal
Admin --> UC_DelJadwal

Admin --> UC_ListGaleri
Admin --> UC_UploadGaleri
Admin --> UC_DelGaleri

Admin --> UC_ListPengumuman
Admin --> UC_AddPengumuman
Admin --> UC_EditPengumuman
Admin --> UC_DelPengumuman

@enduml
