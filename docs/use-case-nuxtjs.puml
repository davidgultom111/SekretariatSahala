@startuml Use Case - Nuxt.js Frontend

skinparam backgroundColor #FEFEFE
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #ECFDF5
  BorderColor #059669
  FontSize 11
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #2563EB
}
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #1E293B
}
skinparam ArrowColor #64748B
skinparam note {
  BackgroundColor #FEF9C3
  BorderColor #CA8A04
}

title **Use Case Diagram — Nuxt.js Frontend**\nAplikasi Web Jemaat (Mobile & Desktop)\nAktor: Pengunjung & Jemaat (Member)

' ============================================================
' ACTORS
' ============================================================
actor "Pengunjung\n(Publik)" as Visitor #LightGreen
actor "Jemaat\n(Member)" as Member #LightBlue

' Jemaat mewarisi semua akses Pengunjung
Visitor <|-- Member

rectangle "Sistem Nuxt.js — Aplikasi Web Jemaat" {

  ' ---------- HALAMAN PUBLIK (tanpa login) ----------
  package "Halaman Publik (Beranda)" {
    usecase "Lihat Beranda\nWebsite Gereja" as UC_Home
    usecase "Lihat Jadwal\nPelayanan" as UC_Jadwal
    usecase "Lihat Galeri\nFoto Gereja" as UC_Galeri
    usecase "Lihat\nPengumuman" as UC_Pengumuman

    note right of UC_Home
      Data jadwal, galeri, pengumuman
      diambil dari endpoint publik
      GET /api/public/*
      (tanpa token, tanpa login)
    end note
  }

  ' ---------- AUTENTIKASI ----------
  package "Autentikasi" {
    usecase "Login\n(ID Jemaat + Password)" as UC_Login
    usecase "Logout" as UC_Logout

    note right of UC_Login
      Hanya member dengan
      status_aktif = 'Aktif'
      yang dapat login
    end note
  }

  ' ---------- PROFIL JEMAAT ----------
  package "Profil Saya" {
    usecase "Lihat Profil\nSendiri" as UC_Profile
    usecase "Update Biodata\nSendiri" as UC_UpdateProfile

    note right of UC_UpdateProfile
      Field: nama, alamat,
      no. telepon, dll.
    end note
  }

  ' ---------- SURAT JEMAAT ----------
  package "Surat Saya" {
    usecase "Lihat Daftar\nSurat Saya" as UC_Letters
    usecase "Cari Surat" as UC_SearchLetter
    usecase "Download PDF\nSurat Saya" as UC_Download

    note bottom of UC_Download
      Hanya surat yang sudah
      disetujui & tersimpan
      (stored PDF only)
    end note
  }

  ' ---------- PENGAJUAN SURAT ----------
  package "Pengajuan Surat" {
    usecase "Lihat Riwayat\nPengajuan" as UC_ListPengajuan
    usecase "Lihat Status\nPengajuan" as UC_StatusPengajuan
    usecase "Buat Pengajuan\nSurat Baru" as UC_CreatePengajuan
    usecase "Isi Form\nSurat Tugas Pelayanan" as UC_FormTP
    usecase "Isi Form\nSurat Pengantar" as UC_FormSP
    usecase "Isi Form\nSurat Ket. Jemaat Aktif" as UC_FormKJA
    usecase "Isi Form\nSurat Nilai Sekolah" as UC_FormNS
    usecase "Isi Form\nSurat Pengajuan Baptisan" as UC_FormPB
    usecase "Isi Form\nSurat Penyerahan Anak" as UC_FormPA
    usecase "Isi Form\nSurat Pengajuan Pernikahan" as UC_FormPP

    note right of UC_ListPengajuan
      Status pengajuan:
      · Dalam Proses
      · Disetujui
      · Ditolak (+ catatan alasan)
    end note

    note right of UC_FormPP
      Membutuhkan ID Jemaat
      pria dan wanita
    end note
  }

}

' ============================================================
' ASSOCIATIONS — Pengunjung
' ============================================================
Visitor --> UC_Home
Visitor --> UC_Jadwal
Visitor --> UC_Galeri
Visitor --> UC_Pengumuman
Visitor --> UC_Login

' ============================================================
' ASSOCIATIONS — Jemaat
' ============================================================
Member --> UC_Logout
Member --> UC_Profile
Member --> UC_UpdateProfile

Member --> UC_Letters
Member --> UC_Download
UC_Letters .> UC_SearchLetter : <<include>>

Member --> UC_ListPengajuan
Member --> UC_CreatePengajuan

' Status pengajuan dilihat dari daftar
UC_ListPengajuan .> UC_StatusPengajuan : <<include>>

' Form pengajuan dipilih setelah memilih tipe surat
UC_CreatePengajuan .> UC_FormTP  : <<extend>>
UC_CreatePengajuan .> UC_FormSP  : <<extend>>
UC_CreatePengajuan .> UC_FormKJA : <<extend>>
UC_CreatePengajuan .> UC_FormNS  : <<extend>>
UC_CreatePengajuan .> UC_FormPB  : <<extend>>
UC_CreatePengajuan .> UC_FormPA  : <<extend>>
UC_CreatePengajuan .> UC_FormPP  : <<extend>>

@enduml
