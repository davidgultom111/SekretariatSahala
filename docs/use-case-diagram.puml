@startuml Use Case Diagram - Sekretariat Jemaat GPdI

skinparam backgroundColor #FEFEFE
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
  FontSize 12
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #2563EB
}
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #1E293B
}
skinparam ArrowColor #64748B
skinparam note {
  BackgroundColor #FEF9C3
  BorderColor #CA8A04
}

title **Use Case Diagram**\nSistem Sekretariat Jemaat GPdI\n(Backend Laravel API + Frontend Nuxt.js)

' ============================================================
' ACTORS
' ============================================================
actor "Pengunjung\n(Publik)" as Visitor #LightGreen
actor "Jemaat\n(Member)" as Member #LightBlue
actor "Admin /\nSekretaris" as Admin #LightCoral

' Inheritance: Admin inherits Member, Member inherits Visitor
Visitor <|-- Member
Member  <|-- Admin

' ============================================================
' SYSTEM BOUNDARY
' ============================================================
rectangle "Sistem Sekretariat Jemaat GPdI" {

  ' ----------------------------------------------------------
  ' PACKAGE: Publik (tanpa login)
  ' ----------------------------------------------------------
  package "Informasi Publik" {
    usecase "Lihat Jadwal\nPelayanan" as UC_Jadwal
    usecase "Lihat Galeri\nFoto" as UC_Galeri
    usecase "Lihat\nPengumuman" as UC_Pengumuman
  }

  ' ----------------------------------------------------------
  ' PACKAGE: Autentikasi
  ' ----------------------------------------------------------
  package "Autentikasi" {
    usecase "Login\n(ID Jemaat + Password)" as UC_Login
    usecase "Logout" as UC_Logout
  }

  ' ----------------------------------------------------------
  ' PACKAGE: Profil Jemaat
  ' ----------------------------------------------------------
  package "Profil Jemaat" {
    usecase "Lihat Profil\nSendiri" as UC_ViewProfile
    usecase "Update Biodata\nSendiri" as UC_UpdateProfile
  }

  ' ----------------------------------------------------------
  ' PACKAGE: Surat Jemaat (self-service)
  ' ----------------------------------------------------------
  package "Surat Jemaat (Self-Service)" {
    usecase "Lihat Daftar\nSurat Saya" as UC_MyLetters
    usecase "Cari Surat" as UC_SearchLetters
    usecase "Download PDF\nSurat Saya" as UC_DownloadMyLetter
    usecase "Buat Pengajuan\nSurat" as UC_CreatePengajuan
    usecase "Lihat Status\nPengajuan" as UC_ViewPengajuan

    note right of UC_CreatePengajuan
      Tipe Pengajuan:
      - Surat Tugas Pelayanan
      - Surat Pengantar
      - Surat Ket. Jemaat Aktif
      - Surat Nilai Sekolah
      - Surat Pengajuan Baptisan
      - Surat Penyerahan Anak
      - Surat Pengajuan Pernikahan
    end note
  }

  ' ----------------------------------------------------------
  ' PACKAGE: Manajemen Jemaat (Admin)
  ' ----------------------------------------------------------
  package "Manajemen Jemaat (Admin)" {
    usecase "Lihat Daftar\nJemaat" as UC_ListMembers
    usecase "Cari & Filter\nJemaat" as UC_SearchMembers
    usecase "Tambah Data\nJemaat" as UC_CreateMember
    usecase "Lihat Detail\nJemaat" as UC_ShowMember
    usecase "Edit Data\nJemaat" as UC_EditMember
    usecase "Hapus Data\nJemaat" as UC_DeleteMember
  }

  ' ----------------------------------------------------------
  ' PACKAGE: Manajemen Surat (Admin)
  ' ----------------------------------------------------------
  package "Manajemen Surat (Admin)" {
    usecase "Lihat Daftar\nSemua Surat" as UC_ListLetters
    usecase "Cari & Filter\nSurat" as UC_SearchLetterAdmin
    usecase "Buat Surat\nBaru" as UC_CreateLetter
    usecase "Lihat Detail\nSurat" as UC_ShowLetter
    usecase "Edit Data\nSurat" as UC_EditLetter
    usecase "Hapus Surat" as UC_DeleteLetter
    usecase "Download / Generate\nPDF Surat" as UC_PdfLetter

    note bottom of UC_PdfLetter
      Generate on-the-fly via DomPDF
      jika file belum tersimpan
    end note
  }

  ' ----------------------------------------------------------
  ' PACKAGE: Kelola Pengajuan Surat (Admin)
  ' ----------------------------------------------------------
  package "Kelola Pengajuan Surat (Admin)" {
    usecase "Lihat Daftar\nPengajuan" as UC_ListPengajuan
    usecase "Review Detail\nPengajuan" as UC_ReviewPengajuan
    usecase "Setujui\nPengajuan" as UC_ApprovePengajuan
    usecase "Tolak\nPengajuan" as UC_RejectPengajuan
    usecase "Hapus\nPengajuan" as UC_DeletePengajuan
  }

  ' ----------------------------------------------------------
  ' PACKAGE: Konten Website (Admin)
  ' ----------------------------------------------------------
  package "Kelola Konten Website (Admin)" {
    usecase "Kelola Jadwal\nPelayanan" as UC_AdminJadwal
    usecase "Kelola Galeri\nFoto" as UC_AdminGaleri
    usecase "Kelola\nPengumuman" as UC_AdminPengumuman

    note right of UC_AdminJadwal
      CRUD: tambah, edit,
      hapus jadwal
    end note

    note right of UC_AdminGaleri
      Upload & hapus
      foto galeri
    end note

    note right of UC_AdminPengumuman
      CRUD: tambah, edit,
      hapus pengumuman
    end note
  }

}

' ============================================================
' ASSOCIATIONS — Pengunjung (Visitor)
' ============================================================
Visitor --> UC_Jadwal
Visitor --> UC_Galeri
Visitor --> UC_Pengumuman
Visitor --> UC_Login

' ============================================================
' ASSOCIATIONS — Jemaat (Member)
' ============================================================
Member --> UC_Logout
Member --> UC_ViewProfile
Member --> UC_UpdateProfile
Member --> UC_MyLetters
Member --> UC_SearchLetters
Member --> UC_DownloadMyLetter
Member --> UC_CreatePengajuan
Member --> UC_ViewPengajuan

' include relationships
UC_MyLetters .> UC_SearchLetters : <<include>>

' ============================================================
' ASSOCIATIONS — Admin
' ============================================================
Admin --> UC_ListMembers
Admin --> UC_SearchMembers
Admin --> UC_CreateMember
Admin --> UC_ShowMember
Admin --> UC_EditMember
Admin --> UC_DeleteMember

Admin --> UC_ListLetters
Admin --> UC_SearchLetterAdmin
Admin --> UC_CreateLetter
Admin --> UC_ShowLetter
Admin --> UC_EditLetter
Admin --> UC_DeleteLetter
Admin --> UC_PdfLetter

Admin --> UC_ListPengajuan
Admin --> UC_ReviewPengajuan
Admin --> UC_ApprovePengajuan
Admin --> UC_RejectPengajuan
Admin --> UC_DeletePengajuan

Admin --> UC_AdminJadwal
Admin --> UC_AdminGaleri
Admin --> UC_AdminPengumuman

' include/extend relationships
UC_ListMembers    .> UC_SearchMembers     : <<include>>
UC_ListLetters    .> UC_SearchLetterAdmin : <<include>>
UC_ReviewPengajuan .> UC_ApprovePengajuan : <<extend>>
UC_ReviewPengajuan .> UC_RejectPengajuan  : <<extend>>

@enduml
